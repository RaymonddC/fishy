{
  "name": "fishy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "extension",
    "functions"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"extension/tests/**/*.test.ts\" \"functions/test/**/*.test.ts\" \"scripts/tests/**/*.test.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "fixtures": "node scripts/make-fixtures.ts",
    "seed": "node scripts/seed.ts",
    "remoteconfig": "node scripts/make-remote-config.ts"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
