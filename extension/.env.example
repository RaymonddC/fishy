# Copy this file to .env.local in this folder and fill it in.
# .env.local is never committed. Do not put real values in this file.

# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase console > App Check > Apps > your web app > Manage debug tokens.
# Treat it like a password: it lets any copy of the app pass App Check.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional. Leave empty to use the Firebase SDK's default cloud model.
VITE_CLOUD_MODEL=

# Optional. The region the Cloud Functions are deployed to. Defaults to asia-southeast1.
VITE_FUNCTIONS_REGION=
