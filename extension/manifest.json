{
  "manifest_version": 3,
  "name": "FISHY",
  "description": "Reads a money request, checks the evidence on this laptop, and phones the real person before money moves.",
  "version": "0.1.0",
  "minimum_chrome_version": "138",
  "action": {
    "default_title": "Open FISHY"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/meet-captions.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/gmail-open-email.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
