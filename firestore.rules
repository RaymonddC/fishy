rules_version = '2';

// Clients may only read. Every write goes through Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    // Names, roles and masked numbers. Phone numbers and PIN records live in
    // directoryPrivate, which no client can read.
    match /directory/{personId} {
      allow read: if request.auth != null;
    }

    // The company's name, domain and staff names, and its suppliers with
    // their past invoices. The laptop needs these to check senders and
    // invoices without asking a server. All of it is demo data.
    match /company/{document} {
      allow read: if request.auth != null;
    }
    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
    }

    // Confirmed bad accounts, domains and numbers. The laptop keeps a copy
    // and matches against it without asking a server. Only Cloud Functions
    // can add to it, and only after a "not me" confirmed with a PIN.
    match /knownBad/{entryId} {
      allow read: if request.auth != null;
    }

    // A phone check can be read only by the person who asked for it.
    match /verifications/{verificationId} {
      allow get: if request.auth != null && resource.data.requesterUid == request.auth.uid;
    }

    // Everything else, including directoryPrivate, verificationSuspects and
    // callCounters, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
